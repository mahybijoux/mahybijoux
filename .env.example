# Copy to .env.local for local development, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key. Safe to expose: every table is protected by Row-Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public canonical URL of the shop, without trailing slash (used for SEO: canonical, sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://mahy.bijoux

# NOTE: the app never needs the Supabase service_role key. Do NOT add it here.
